      "image_slots": [
        {
          "slot_id": "P2-IMG-01",
          "asset_id": "seven_roads_story2_p2_img_01_v1",
          "after_text": "Они понесли ящик."
        },
        {
          "slot_id": "P2-IMG-02",
          "asset_id": "seven_roads_story2_p2_img_02_v1",
          "after_text": "Когда через несколько минут он снова посмотрел туда, двое незнакомцев уже затерялись среди остальных людей."
        }
      ]
    },
