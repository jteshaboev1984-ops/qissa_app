# Local generation remains the default and needs no backend.
VITE_QISSA_STORY_PROVIDER=local

# Set provider=remote and point these to the deployed Supabase Edge Functions.
VITE_QISSA_STORY_ENDPOINT=
VITE_QISSA_STATE_ENDPOINT=
VITE_QISSA_SUPABASE_PUBLISHABLE_KEY=
VITE_QISSA_STORY_TIMEOUT_MS=130000
VITE_QISSA_STORY_FALLBACK_TO_LOCAL=true

# Server-only Supabase Edge Function secrets (never prefix these with VITE_):
# OPENAI_API_KEY=...
# Story AI is fail-closed: the reviewed production rollout gate must be ON and the service-role-only
# qissa_runtime_flags.story_ai_enabled flag must be true. The legacy QISSA_AI_ENABLED secret is no longer used.
# OPENAI_ARCHITECT_MODEL=gpt-5.6-luna
# OPENAI_NARRATOR_MODEL=gpt-5.6-luna
# OPENAI_SAFETY_MODEL=gpt-5.6-luna
# OPENAI_NARRATOR_ESCALATION_MODEL=  # keep empty unless a reviewed escalation rollout is approved
